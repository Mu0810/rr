# ─────────────────────────────────────────────────────────────────────────────
#  Rocket Recruiters — configuration
#
#  Copy this file to `.env`, fill in your values, then:
#
#      cp .env.example .env
#      chmod 600 .env          # only you can read it
#      npm run start:env
#
#  `.env` is already in .gitignore — it will never be committed.
#  Everything below is optional except where marked.
# ─────────────────────────────────────────────────────────────────────────────


# ── Server ───────────────────────────────────────────────────────────────────

PORT=4173

# Keep this on loopback while testing. Only widen it when the app sits behind a
# reverse proxy that terminates HTTPS (Caddy, nginx, Cloudflare Tunnel).
HOST=127.0.0.1

# Your public address once deployed. Used for the "open in dashboard" link
# inside notification emails. Leave blank while running locally.
PUBLIC_URL=

# Set to true once you are served over HTTPS, so the admin session cookie is
# only ever sent over an encrypted connection.
COOKIE_SECURE=false


# ── Dashboard password (REQUIRED before going public) ────────────────────────
# Generate a strong one:   openssl rand -base64 24

ADMIN_PASSWORD=replace-with-a-long-random-password


# ── The office ───────────────────────────────────────────────────────────────
# All roles are onsite here. Candidates needing remote are turned away on
# step one of the form.

OFFICE_ADDRESS=Udyog Vihar Phase 2, Sector 20, Gurugram
OFFICE_CITY=Gurugram
OFFICE_REGION=Delhi NCR


# ── Email: every application lands in your inbox ─────────────────────────────
#
# Gmail / Google Workspace needs an APP PASSWORD, not your normal password:
#   Google Account → Security → 2-Step Verification → App passwords
#   Generate one, then paste the 16 characters below WITHOUT the spaces.
#
# Zoho:    smtp.zoho.in        port 465
# Brevo:   smtp-relay.brevo.com port 587
# SES:     email-smtp.<region>.amazonaws.com port 465

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# The mailbox you are sending FROM. For Gmail this must be the account that
# owns the app password, or a verified alias of it.
SMTP_USER=you@yourdomain.com
SMTP_PASS=your16charapppassword

# What candidates would see as the sender. Keep the address identical to
# SMTP_USER; only the display name is free text.
MAIL_FROM=Rocket Recruiters <you@yourdomain.com>

# Who receives each application. Comma-separated for more than one person.
MAIL_TO=you@yourdomain.com

# Reply-To is set automatically to the candidate's own address, so replying
# from your inbox writes straight to them. Nothing to configure.


# ── Google Sheet: one row per application ────────────────────────────────────
# Setup lives in google-apps-script/Code.gs — paste it into your Sheet's
# Apps Script editor, deploy as a Web app, then put the /exec URL here.

SHEETS_WEBHOOK_URL=
SHEETS_SHARED_SECRET=


# ── Optional: Slack / Zapier / n8n ───────────────────────────────────────────

NOTIFY_WEBHOOK_URL=


# ── Storage ──────────────────────────────────────────────────────────────────
# Both hold candidate personal data. Back them up somewhere off this machine
# before you take real applications.

DB_PATH=data/applications.db
UPLOAD_DIR=uploads


# ── Abuse limits ─────────────────────────────────────────────────────────────
# Stored applications per IP per hour, and total requests per IP per hour.
# Failed validation does not count against the submission limit.

RATE_LIMIT_SUBMISSIONS=5
RATE_LIMIT_ATTEMPTS=60
